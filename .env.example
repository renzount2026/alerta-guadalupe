# ============================================================
# ALERTA GUADALUPE - VARIABLES DE ENTORNO PARA NUBE Y LOCAL
# ============================================================
# Copia este archivo como .env tanto en la raíz como en web/ y server/

# 1. SUPABASE (Base de Datos PostgreSQL y Realtime WebSockets)
# Obtén estos valores desde tu proyecto en https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secreta_service_role_aqui

# 2. VITE WEB FRONTEND
# En Vite, las variables accesibles en el navegador deben tener el prefijo VITE_
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon_aqui
# Deja VITE_API_URL vacío en Vercel para usar el mismo dominio (/api)
# O usa http://localhost:4000 para desarrollo local
VITE_API_URL=

# 3. PUERTO LOCAL (Solo para servidor Express local)
PORT=4000
