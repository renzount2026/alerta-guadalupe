{
  "version": 2,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "routes": [
    {
      "src": "/api/alerts/stream",
      "dest": "/api/alerts/stream.js"
    },
    {
      "src": "/api/alerts/(.*)",
      "dest": "/api/alerts/index.js"
    },
    {
      "src": "/api/alerts",
      "dest": "/api/alerts/index.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/alerts/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
